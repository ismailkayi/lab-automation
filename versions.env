# Product versions used by the lab scripts. Change a value here instead of editing a script.
#
# Format: one KEY=value per line. The value has no quotes or spaces and uses only letters, digits
# and . _ / : @ , + ~ - ; comments need their own line.
# A variable exported in your shell wins over this file for that run, for example:
#   MAAS_CHANNEL=3.9/stable ./orchestrate.sh
#
# Only new installs read these values. Nothing that is already installed is upgraded;
# destroy the environment and build it again to get other versions. The exceptions are
# CM_KEYCLOAK_IMAGE and COS_LITE_REF, which are applied again on every run.
# A floating channel such as latest/stable can resolve to a different revision on a different day.
#
# Not covered: the tools installed on this host by prep_host.sh (LXD, OpenTofu, Ansible).

# ----- All labs (menu 1-6) -----
# Ubuntu image of every lab VM. Changing it can make OpenTofu replace the VMs of an existing lab.
UBUNTU_IMAGE=ubuntu:24.04

# ----- Automated deployments (menu 1-3) -----
# The training labs (menu 4-6) install none of these; participants follow the lab guide.
# MicroCloud snaps are released as a set: change them together.
LXD_CHANNEL=6/stable
MICROCEPH_CHANNEL=tentacle/stable
MICROOVN_CHANNEL=26.03/stable
MICROCLOUD_CHANNEL=3/stable
# The Canonical Kubernetes snap and charm tracks move together. The canonical-kubernetes
# bundle stopped at 1.32, so the charms are deployed directly.
K8S_CHANNEL=1.35-classic/stable
K8S_CHARM_CHANNEL=1.35/stable
# Must match the Ubuntu release of UBUNTU_IMAGE.
K8S_CHARM_BASE=ubuntu@24.04
JUJU_CHANNEL=3.6/stable

# ----- Cluster Manager (menu 9) -----
CM_VM_IMAGE=ubuntu:24.04
CM_K8S_CHANNEL=1.35-classic/stable
CM_JUJU_CHANNEL=3.6/stable
CM_POSTGRESQL_CHANNEL=14/stable
CM_CERTIFICATES_CHANNEL=1/stable
# Traefik has only the latest and an old 1.0 track, so this channel follows new releases.
CM_TRAEFIK_CHANNEL=latest/stable
CM_CLUSTER_MANAGER_CHANNEL=latest/stable
CM_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1

# ----- Landscape (menu 10) -----
LANDSCAPE_VM_IMAGE=ubuntu:24.04
# Selects the self-hosted PPA (ppa:landscape/self-hosted-<release>) and the expected server version.
LANDSCAPE_RELEASE=26.04
# Ubuntu releases of the demo clients, separated by commas.
LANDSCAPE_CLIENT_RELEASES=26.04,24.04,22.04
LANDSCAPE_DEBARCHIVE_CHANNEL=latest/stable
LANDSCAPE_TASK_HANDLER_CHANNEL=latest/stable
LANDSCAPE_OUTBOX_CHANNEL=latest/stable

# ----- COS Lite (menu 11) -----
COS_VM_IMAGE=ubuntu:24.04
COS_K8S_CHANNEL=1.35-classic/stable
COS_JUJU_CHANNEL=3.6/stable
COS_OPENTOFU_CHANNEL=latest/stable
# Git ref of the canonical/observability-stack Terraform module. It also selects the COS Lite charm channels.
COS_LITE_REF=track/3.1
COS_SCRAPE_TARGET_CHANNEL=3.0/stable

# ----- MAAS (menu 12) -----
MAAS_VM_IMAGE=ubuntu:24.04
MAAS_CHANNEL=3.8/stable
MAAS_POSTGRESQL_CHANNEL=16/stable
MAAS_LXD_CHANNEL=5.21/stable
# Ubuntu series that MAAS imports and the demo machines run.
MAAS_DEPLOY_SERIES=noble
